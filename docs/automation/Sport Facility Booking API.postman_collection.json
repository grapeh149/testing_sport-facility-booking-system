          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData = {};",
                  "try { jsonData = pm.response.json(); } catch (e) { jsonData = {}; }",
                  "const authData = jsonData.data || {};",
                  "if (jsonData.success && authData.token) {",
                  "  pm.collectionVariables.set(\"token\", authData.token);",
                  "  pm.collectionVariables.set(\"userId\", authData.userId);",
                  "  pm.collectionVariables.set(\"email\", authData.email);",
                  "  pm.collectionVariables.set(\"role\", authData.role);",
