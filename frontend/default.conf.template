server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Cho phép React Router (client-side routing) không bị 404 khi F5
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 127.0.0.11 là DNS server nội bộ của Docker.
    # Dùng resolver + biến $backend_upstream để nginx resolve LẠI MỖI REQUEST
    # thay vì chỉ 1 lần lúc container start - tránh lỗi "host not found in upstream"
    # nếu backend container start chậm hơn hoặc bị restart.
    resolver 127.0.0.11 valid=10s;

    # Nếu deploy backend và frontend riêng biệt trên Azure, đổi ${BACKEND_URL}
    # thành domain thật của backend (vd: https://myapp-backend.azurewebsites.net)
    location /api/ {
        set $backend_upstream "${BACKEND_URL}";
        proxy_pass $backend_upstream/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
}